   "source": [
    "def isPalindrome(x):\n",
    "\n",
    "    string_x = str(x)\n",
    "    \n",
    "    for i in range(len(string_x)):\n",
    "        if string_x[i] != string_x[len(string_x) - 1 - i]:\n",
    "            return False\n",
    "    return True\n",
    "    \n",
    "\n",
    "isPalindrome(100001)\n",
    "        \n",
    "        \n",
    "    "
   ]
